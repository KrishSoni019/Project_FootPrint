generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  deadline    DateTime?
  ownerId     Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner   User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members ProjectMember[]
  tasks   Task[]
  activities ManualActivity[]

  @@index([ownerId])
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreator")
  manualActivities ManualActivity[]

  @@unique([projectId, userId])
  @@index([userId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          Int          @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  assigneeId  Int?
  createdById Int
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  ProjectMember? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy ProjectMember  @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([assigneeId])
  @@index([createdById])
}

enum ManualActivityType {
  RESEARCH
  DOCUMENTATION
  TESTING
  DESIGN
  MEETING
}

model ManualActivity {
  id           Int                @id @default(autoincrement())
  projectId    Int
  memberId     Int
  type         ManualActivityType
  title        String
  description  String
  evidenceUrl  String?
  activityDate DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([memberId])
  @@index([projectId, activityDate])
}
